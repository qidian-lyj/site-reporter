# ============================================================
# Site Reporter — environment variables (server)
# Copy this file to `.env` in the project root for local use:
#   node --env-file=.env server/server.js
# On Render, set these in the dashboard instead
# (Environment → Environment Variables).
# ============================================================

# --- Upstash Redis (persistent cloud storage) ---
# Create a free database at https://upstash.com → Console → Redis,
# then copy the REST API credentials shown on the database page.
# When both are set, reports persist across redeploys and are shared
# by every device. When unset, the server falls back to the local
# JSON file (dev mode).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# --- CORS ---
# Lock the API to your deployed front end (optional):
# CORS_ORIGIN=https://site-reporter-seven.vercel.app
